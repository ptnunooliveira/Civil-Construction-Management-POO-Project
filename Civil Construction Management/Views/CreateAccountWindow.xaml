<Window x:Class="Civil_Construction_Management.Views.CreateAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Civil_Construction_Management.Views"
        mc:Ignorable="d"
            Title="Create Account" Height="500" Width="400">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Views/Images/CreateAccountBackground.jpg" Stretch="UniformToFill" Opacity="0.7" AlignmentX="Right">
                <ImageBrush.Transform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </ImageBrush.Transform>
            </ImageBrush>
        </Grid.Background>
        <StackPanel 
        Background="Transparent" 
        Width="300px" 
        Height="70px" 
        VerticalAlignment="Top"
        Margin="0 50 0 0">
            <Label
            Content="BuildSmart"                                
            FontSize="60"
            FontStyle="Italic"
            FontFamily="Impact"
            Foreground="Yellow">
            </Label>
        </StackPanel>

        <Grid Width="250" Height="150" VerticalAlignment="Bottom" Margin="0 0 0 150">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Label 
            Grid.Row="0"
            Content="Create Account"                
            FontSize="22"
            Foreground="Yellow"
            FontFamily="Segoe UI Semilight"
            Margin="0 0 0 0"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center">
            </Label>

            <StackPanel Grid.Row="1" Orientation="Vertical">
                <TextBox 
                Name ="UsernameCreateTextBox" 
                Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"                    
                FontFamily="Courier New"
                Foreground="LightGray"                   
                Height="30px"
                Width="250px"
                HorizontalContentAlignment="center"
                VerticalContentAlignment="center"
                BorderBrush="Black"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Vertical">
                <TextBox 
                Name ="PasswordCreateTextBox" 
                Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"                    
                FontFamily="Courier New"
                Foreground="LightGray"                   
                Height="30px"
                Width="250px"
                HorizontalContentAlignment="center"
                VerticalContentAlignment="center"
                Margin="0 5 0 0"
                BorderBrush="Black"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Vertical">
                <TextBox 
                    Name ="PasswordCreateConfirmTextBox" 
                    Text="{Binding PasswordConfirmation, UpdateSourceTrigger=PropertyChanged}"                    
                    FontFamily="Courier New"
                    Foreground="LightGray"                   
                    Height="30px"
                    Width="250px"
                    HorizontalContentAlignment="center"
                    VerticalContentAlignment="center"
                    Margin="0 5 0 0"
                    BorderBrush="Black"/>
            </StackPanel>
        </Grid>

        <Grid VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="150px" Height="60px" Margin="0 0 25 25">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <Button Grid.Row="0"
                Content="Create Account"
                FontSize="16"
                Background="Yellow"
                Foreground="Black"
                FontFamily="Segoe UI Light"
                HorizontalContentAlignment="center"
                VerticalContentAlignment="center"
                BorderBrush="Black"
                Width="120px"
                Command="{Binding CreateAccountCommand}"/>
            </StackPanel>

            <StackPanel Margin="0 25 0 0">
                <Button Grid.Row="1"
                Content="Already have an account"
                FontSize="12"
                Background="Transparent"
                Foreground="Yellow"
                FontFamily="Segoe UI Light"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Bottom"
                BorderBrush="Transparent"
                Command="{Binding LoginPageCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>