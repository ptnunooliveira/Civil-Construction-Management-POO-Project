<Window x:Class="Civil_Construction_Management.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Civil_Construction_Management"
        xmlns:vm="clr-namespace:Civil_Construction_Management.ViewModels"
        xmlns:views="clr-namespace:Civil_Construction_Management.Views.MainViews"
        mc:Ignorable="d"
        Title="BuildSmart" Height="470" Width="800">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ListingEmployeeViewModel}">
            <views:EmployeeView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ListingProjectViewModel}">
            <views:ProjectView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Views/Images/MainWindowBackground.png"
                    Stretch="UniformToFill"/>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0"
            BorderThickness="3"
            BorderBrush="Black"
            Margin="10 20 10 0">
            <Grid Background="MediumOrchid">
                <TextBlock Text="Items"
                    FontFamily="Impact"
                    FontStyle="Italic"
                    FontSize="30"
                    Foreground="Yellow"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Grid>            
        </Border>
                
        <Border Grid.Row="1" Grid.Column="0"
            BorderThickness="3"
            BorderBrush="Black"
            Margin="10 5 10 20">
            <Grid Background="Transparent" Margin="0 60 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="Employee"
                    FontFamily="Segoe UI Light"
                    FontSize="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0 0 0 0"
                    Command="{Binding ShowEmployeesCommand}">                    
                </Button>

                <Button Grid.Row="1"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="Projects"
                    FontFamily="Segoe UI Light"
                    FontSize="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0 0 0 0"
                    Command="{Binding ShowProjectsCommand}">
                </Button>

                <Button Grid.Row="2"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="Vehicles"
                    FontFamily="Segoe UI Light"
                    FontSize="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0 0 0 0">
                </Button>

                <Button Grid.Row="3"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="Warehouses"
                    FontFamily="Segoe UI Light"
                    FontSize="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0 0 0 0">
                </Button>

                <Button Grid.Row="4"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="Subcontractors"
                    FontFamily="Segoe UI Light"
                    FontSize="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0 0 0 0">
                </Button>

                <Button Grid.Row="5"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="Project's Budgets"
                    FontFamily="Segoe UI Light"
                    FontSize="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0 0 0 0">
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="0" Grid.Column="1"
            BorderThickness="3"
            BorderBrush="Black"
            Margin="10 20 10 0">
            <Grid Background="MediumOrchid">
                <TextBlock Text="Information"
            FontFamily="Impact"
            FontStyle="Italic"
            FontSize="30"
            Foreground="Yellow"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1"
            BorderThickness="3"
            BorderBrush="Black"
            Margin="10 5 10 20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>                    
                </Grid.RowDefinitions>
                
                <ContentControl Grid.Row="0" Content="{Binding CurrentViewModel}"/>

                <Button Grid.Row="1" Content="Add"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0 5 125 10"
                        Width="50"
                        Height="25"
                        Background="Yellow"
                        BorderThickness="2"
                        FontFamily="Segoe UI Light"                        
                        Command="{Binding CurrentAddCommand}"/>

                <Button Grid.Row="1" Content="Edit"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0 5 65 10"
                        Width="50"
                        Height="25"
                        Background="Yellow"
                        BorderThickness="2"
                        FontFamily="Segoe UI Light"
                        Command="{Binding CurrentEditCommand}"
                        CommandParameter="{Binding CurrentViewModel.SelectedObject}"/>

                <Button Grid.Row="1" Content="Delete"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0 5 5 10"
                        Width="50"
                        Height="25"
                        Background="Yellow"
                        BorderThickness="2"
                        FontFamily="Segoe UI Light"                        
                        Command="{Binding CurrentDeleteCommand}"
                        CommandParameter="{Binding CurrentViewModel.SelectedObject}"/>
                        
            </Grid>
            
        </Border>
    </Grid>
</Window>
