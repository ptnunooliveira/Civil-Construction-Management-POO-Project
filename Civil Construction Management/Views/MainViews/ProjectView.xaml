<UserControl x:Class="Civil_Construction_Management.Views.MainViews.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <Grid VerticalAlignment="Stretch">        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ListView Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" x:Name="ProjectListView"
                      Background="Transparent"
                      ItemsSource="{Binding Projects}"
                      SelectedItem="{Binding SelectedObject, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">

            <ListView.Resources>
                <Style TargetType="GridViewColumnHeader">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GridViewColumnHeader">
                                <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="0" 
                                HorizontalAlignment="Stretch">
                                    <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.Resources>

            <ListView.View>
                <GridView >

                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding ID}" Width="Auto"/>
                    <GridViewColumn Header="Client" DisplayMemberBinding="{Binding ClientName}" Width="Auto"/>
                    <GridViewColumn Header="Address" DisplayMemberBinding="{Binding Address}" Width="Auto"/>
                    <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="Auto"/>

                </GridView>
            </ListView.View>
        </ListView>

        

        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text=" Materials" FontWeight="Bold" VerticalAlignment="Center" FontSize="16"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Height="15" Width="45">
                <Button Content="+" Width="15" Height="15" ToolTip="Add Material" Command="{Binding AddMaterialCommand}" CommandParameter="{Binding SelectedObject}"/>
                <Button Content="-" Width="15" Height="15" Margin="2 0 0 0" ToolTip="Delete Material" Command="{Binding DeleteMaterialCommand}" CommandParameter="{Binding SelectedMaterial}"/>
            </StackPanel>
            
            <ListView Grid.Column="1" Grid.Row="1" x:Name="MaterialListView"
                  Background="Transparent"
                  ItemsSource="{Binding SelectedObject.Materials}"
                  SelectedItem="{Binding SelectedMaterial, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">

                <ListView.Resources>
                    <Style TargetType="GridViewColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GridViewColumnHeader">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="0" 
                                            HorizontalAlignment="Stretch">
                                        <ContentPresenter HorizontalAlignment="Stretch"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.Resources>

                <ListView.View>
                    <GridView >
                        <GridViewColumn Header="  Name" DisplayMemberBinding="{Binding Name}" Width="Auto"/>
                        <GridViewColumn Header="  N" DisplayMemberBinding="{Binding Quantity}" Width="Auto"/>
                        <GridViewColumn Header="  €" DisplayMemberBinding="{Binding UnitPrice}" Width="Auto"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>



        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text=" Services" FontWeight="Bold" VerticalAlignment="Center" FontSize="16"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Height="15" Width="45">
                <Button Content="+" Width="15" Height="15" ToolTip="Add Service" Command="{Binding AddServiceCommand}" CommandParameter="{Binding SelectedObject}"/>
                <Button Content="-" Width="15" Height="15" Margin="2 0 0 0" ToolTip="Delete Service" Command="{Binding DeleteServiceCommand}" CommandParameter="{Binding SelectedService}"/>
            </StackPanel>

            <ListView Grid.Column="1" Grid.Row="1" x:Name="ServiceListView"
                  Background="Transparent"
                  ItemsSource="{Binding SelectedObject.Services}"
                  SelectedItem="{Binding SelectedService, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">

                <ListView.Resources>
                    <Style TargetType="GridViewColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GridViewColumnHeader">
                                    <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="0" 
                                        HorizontalAlignment="Stretch">
                                        <ContentPresenter HorizontalAlignment="Stretch"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.Resources>

                <ListView.View>
                    <GridView >

                        <GridViewColumn Header=" Company" DisplayMemberBinding="{Binding CompanyName}" Width="Auto"/>
                        <GridViewColumn Header=" Status" DisplayMemberBinding="{Binding Status}" Width="Auto"/>
                        <GridViewColumn Header=" Start Date" DisplayMemberBinding="{Binding StartDate, StringFormat={}{0:dd/MM/yyyy}}" Width="Auto"/>
                        <GridViewColumn Header=" End Date" DisplayMemberBinding="{Binding EndDate, StringFormat={}{0:dd/MM/yyyy}}" Width="Auto"/>

                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>



        <Grid Grid.Row="2" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text=" Employees" FontWeight="Bold" VerticalAlignment="Center" FontSize="16"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Height="15" Width="45">
                <Button Content="+" Width="15" Height="15" ToolTip="Add Employee" Command="{Binding SelectEmployeeCommand}" CommandParameter="{Binding SelectedObject}"/>
                <Button Content="-" Width="15" Height="15" Margin="2 0 0 0" ToolTip="Delete Employee" Command="{Binding DeleteEmployeeCommand}" CommandParameter="{Binding SelectedEmployee}"/>
            </StackPanel>

            <ListView Grid.Column="1" Grid.Row="2" x:Name="EmployeeListView"
                  Background="Transparent"
                  ItemsSource="{Binding SelectedObject.Employees}"
                  SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">

                <ListView.Resources>
                    <Style TargetType="GridViewColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GridViewColumnHeader">
                                    <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="0" 
                                        HorizontalAlignment="Stretch">
                                        <ContentPresenter HorizontalAlignment="Stretch"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.Resources>

                <ListView.View>
                    <GridView >
                        
                        <GridViewColumn Header=" ID" DisplayMemberBinding="{Binding ID}" Width="Auto"/>
                        <GridViewColumn Header=" Name" DisplayMemberBinding="{Binding Name}" Width="Auto"/>
                        <GridViewColumn Header=" Contact" DisplayMemberBinding="{Binding PhoneNumber}" Width="Auto"/>
                        <GridViewColumn Header=" Email" DisplayMemberBinding="{Binding Email}" Width="Auto"/>

                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>


    </Grid>    
</UserControl>