<UserControl x:Class="Civil_Construction_Management.Views.MainViews.EmployeeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Civil_Construction_Management.Views.MainViews"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <ListView Background="Transparent" ItemsSource="{Binding Employees}">
            <ListView.Resources>
                <Style TargetType="GridViewColumnHeader">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="FontFamily" Value="Impact"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="5,2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GridViewColumnHeader">
                                <Border Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="0">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.Resources>

            <ListView.View>
                <GridView>
                    <GridViewColumn Header=" ID " DisplayMemberBinding="{Binding ID}" Width="Auto"/>
                    <GridViewColumn Header=" Name " DisplayMemberBinding="{Binding Name}" Width="Auto"/>
                    <GridViewColumn Header=" NIF " DisplayMemberBinding="{Binding NIF}" Width="Auto"/>
                    <GridViewColumn Header=" Phone " DisplayMemberBinding="{Binding PhoneNumber}" Width="Auto"/>
                    <GridViewColumn Header=" Email " DisplayMemberBinding="{Binding Email}" Width="Auto"/>
                    <GridViewColumn Header=" Role " DisplayMemberBinding="{Binding Role}" Width="Auto"/>
                    <GridViewColumn Header=" Salary/Hour " DisplayMemberBinding="{Binding SalaryHour}" Width="Auto"/>
                    <GridViewColumn Header=" Work Hours " DisplayMemberBinding="{Binding WorkHours}" Width="Auto"/>
                    <GridViewColumn Header=" Start Date " DisplayMemberBinding="{Binding StartDate}" Width="Auto"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Grid Background="Transparent" 
            Height="50"
            Width="200"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Right"
            Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                Background="Yellow"
                Width="60"
                Height="25"
                Content="Add"
                FontFamily="Segoe UI Light"
                FontSize="16"
                BorderBrush="Black"
                BorderThickness="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Command="{Binding AddEmployeeCommand}">
            </Button>

            <Button Grid.Column="1"
                Background="Yellow"
                Width="60"
                Height="25"
                Content="Delete"
                FontFamily="Segoe UI Light"
                FontSize="16"
                BorderBrush="Black"
                BorderThickness="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Margin="20 0 0 0">
            </Button>
        </Grid>            
    </Grid>
</UserControl>