<UserControl x:Class="Civil_Construction_Management.Views.MainViews.EmployeeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <ListView x:Name="EmployeeListView"
                  Background="Transparent"
                  ItemsSource="{Binding Employees}"
                  SelectedItem="{Binding SelectedObject, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">

            <ListView.Resources>
                <Style TargetType="GridViewColumnHeader">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GridViewColumnHeader">
                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="0" 
                                        HorizontalAlignment="Stretch">
                                    <ContentPresenter HorizontalAlignment="Stretch"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.Resources>

            <ListView.View>
                <GridView>

                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding ID}" Width="Auto"/>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="Auto"/>
                    <GridViewColumn Header="NIF" DisplayMemberBinding="{Binding NIF}" Width="Auto"/>
                    <GridViewColumn Header="Phone" DisplayMemberBinding="{Binding PhoneNumber}" Width="Auto"/>
                    <GridViewColumn Header="Email" DisplayMemberBinding="{Binding Email}" Width="Auto"/>
                    <GridViewColumn Header="Role" DisplayMemberBinding="{Binding Role}" Width="Auto"/>
                    <GridViewColumn Header="Salary" DisplayMemberBinding="{Binding SalaryHour}" Width="Auto"/>
                    <GridViewColumn Header=" Start Date" DisplayMemberBinding="{Binding StartDate, StringFormat={}{0:dd/MM/yyyy}}" Width="Auto"/>
                    
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>