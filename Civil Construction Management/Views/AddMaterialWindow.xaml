<Window x:Class="Civil_Construction_Management.Views.AddMaterialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Civil_Construction_Management.Views"
        mc:Ignorable="d"
        Title="Material" Height="500" Width="400">
    <Grid>


        <Grid.Background>
            <ImageBrush ImageSource="/Views/Images/AddEmployeeBackground.png" Stretch="UniformToFill" Opacity="0.5" AlignmentX="Right">
                <ImageBrush.Transform>
                    <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                </ImageBrush.Transform>
            </ImageBrush>
        </Grid.Background>
        <StackPanel 
            Background="Transparent" 
            Width="300px" 
            Height="70px" 
            VerticalAlignment="Top"
            Margin="0 50 0 0">
            <Label
                Content="Material"                                
                FontSize="36"
                FontStyle="Italic"
                FontFamily="Impact"
                Foreground="DarkOrange"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            </Label>
        </StackPanel>


        <Grid Margin="40 100 20 100">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>


            <Label Grid.Row="0" Grid.Column="0"
                   Content="Name"
                   HorizontalAlignment="Left"
                   FontSize="14"
                   Foreground="Black"
                   FontFamily="Segoe UI Semilight">
            </Label>
            <StackPanel Grid.Row="1">
                <TextBox Name="MaterialNameTextBox"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Courier New"
                         Foreground="LightGray"
                         HorizontalContentAlignment="center"
                         VerticalContentAlignment="center"
                         BorderBrush="Black"
                         BorderThickness="1.5"
                         Height="20"
                         Margin="5 0 0 0">
                </TextBox>
            </StackPanel>


            <Label Grid.Row="2" Grid.Column="0"
                   Content="Quantity"
                   HorizontalAlignment="Left"
                   FontSize="14"
                   Foreground="Black"
                   FontFamily="Segoe UI Semilight">
            </Label>
            <StackPanel Grid.Row="3">
                <TextBox Name="MaterialQuantityTextBox"
                         Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Courier New"
                         Foreground="LightGray"
                         HorizontalContentAlignment="center"
                         VerticalContentAlignment="center"
                         BorderBrush="Black"
                         BorderThickness="1.5"
                         Width="100"
                         Height="20"
                         HorizontalAlignment="Left"
                         Margin="5 0 0 0">
                </TextBox>
            </StackPanel>


            <Label Grid.Row="2" Grid.Column="1"
                   Content="Unit Price"
                   HorizontalAlignment="Left"
                   FontSize="14"
                   Foreground="Black"
                   FontFamily="Segoe UI Semilight">
            </Label>
            <StackPanel Grid.Row="3" Grid.Column="1">
                <TextBox Name="MaterialUnitPriceTextBox"
                         Text="{Binding UnitPrice}"
                         FontFamily="Courier New"
                         Foreground="LightGray"
                         HorizontalContentAlignment="center"
                         VerticalContentAlignment="center"
                         BorderBrush="Black"
                         BorderThickness="1.5"
                         Width="100"
                         Height="20"
                         HorizontalAlignment="Left"
                         Margin="5 0 0 0">
                </TextBox>
            </StackPanel>
        </Grid>

        <Grid Margin="20"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Height="25"
              Width="60">

            <Button Background="BlanchedAlmond"
                    Content="Save"
                    FontFamily="Segoe UI Light"
                    Foreground="DarkOrange"
                    BorderBrush="Black"                    
                    BorderThickness="1.5"
                    Command="{Binding SaveMaterialCommand}">
            </Button>
        </Grid>
    </Grid>
</Window>

